#Events		;! 12 total

$Formula: ( when
   ( true )
   ( ship-guardian "Alpha 1" )
   ( ship-vulnerable "Alpha 1" )
   ( send-message "#Command" "High" "Start" )
)
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when
   ( true )
   ( sabotage-subsystem "Alpha 1" "engines" 70 )
   ( sabotage-subsystem "Alpha 1" "weapons" 60 )
)
+Name: Damage
+Repeat Count: 1
+Interval: 1
+Chained: 30

$Formula: ( when
   ( true )
   ( clear-goals "Alpha 1" )
   ( add-goal "Alpha 1" ( ai-chase "Lilith" 89 ) )
   ( send-message "#Command" "High" "Cruiser" )
)
+Name: Cruiser
+Repeat Count: 1
+Interval: 1
+Chained: 40

$Formula: ( when
   ( true )
   ( turret-free-all "Lilith" )
)
+Name: Flak
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( clear-goals "Alpha 1" )
   ( add-goal "Alpha 1" ( ai-guard "Freighter" 89 ) )
   ( send-message "#Command" "High" "Guard" )
)
+Name: Guard
+Repeat Count: 1
+Interval: 1
+Chained: 40

$Formula: ( when
   ( true )
   ( clear-goals "Alpha 1" )
   ( add-goal "Alpha 1" ( ai-waypoints-once "Patrol" 89 ) )
)
+Name: Patrol
+Repeat Count: 1
+Interval: 1
+Chained: 40

$Formula: ( when
   ( true )
   ( ship-no-guardian "Alpha 1" )
   ( self-destruct "Alpha 1" )
)
+Name: End
+Repeat Count: 1
+Interval: 1
+Chained: 30

$Formula: ( is-destroyed-delay 0 "Kappa" )
+Name: Kappa down
+Repeat Count: 1
+Interval: 1
+Objective:  XSTR("Destroy Kappa", -1)

$Formula: ( > ( distance "Alpha 1" "Buoy" ) 800 )
+Name: Player moved
+Repeat Count: 1
+Interval: 1

$Formula: ( < ( hits-left "Alpha 1" ) 80 )
+Name: Player hurt
+Repeat Count: 1
+Interval: 1

$Formula: ( and ( is-event-true-delay "Damage" 1 ) ( > ( hits-left-subsystem "Alpha 1" "engines" ) 90 ) )
+Name: Engine fixed
+Repeat Count: 1
+Interval: 1

$Formula: ( is-destroyed-delay 0 "Lilith" )
+Name: Lilith down
+Repeat Count: 1
+Interval: 1

