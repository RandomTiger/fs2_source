#Events		;! 21 total

$Formula: ( when
   ( true )
   ( modify-variable @count[0] ( + @count[0] 1 ) )
)
+Name: Counter
+Repeat Count: 5
+Interval: 3

$Formula: ( = @count[0] 5 )
+Name: Counted
+Repeat Count: 1
+Interval: 1
+Objective:  XSTR("Count to five", -1)

$Formula: ( when
   ( true )
   ( send-message "#Command" "High" "Start" )
)
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when
   ( true )
   ( send-message "Beta 1" "Normal" "Engaging" )
)
+Name: Hostiles
+Repeat Count: 1
+Interval: 1
+Chained: 3

$Formula: ( when
   ( true )
   ( send-message "#Command" "Low" "Low 1" )
   ( send-message "#Command" "Low" "Low 2" )
   ( send-message "Beta 2" "Normal" "Normal 1" )
   ( send-message "Beta 3" "Normal" "Normal 2" )
   ( send-message "#Command" "High" "High 1" )
   ( send-message "#Command" "High" "High 2" )
   ( send-random-message "#Command" "Normal" "Low 1" "Low 2" "Normal 1" )
)
+Name: Flood
+Repeat Count: 1
+Interval: 1
+Chained: 8

$Formula: ( when
   ( true )
   ( send-message-list "#Command" "High" "List 1" 0 "Beta 1" "Normal" "List 2" 3000 "#Command" "Low" "List 3" 2000 )
)
+Name: List
+Repeat Count: 1
+Interval: 1
+Chained: 4

$Formula: ( when
   ( true )
   ( transfer-cargo "Container" "Poseidon" )
   ( exchange-cargo "Poseidon" "Container" )
   ( cargo-no-deplete "Poseidon" )
)
+Name: Cargo
+Repeat Count: 1
+Interval: 1
+Chained: 8

$Formula: ( when
   ( true )
   ( jettison-cargo-delay "Poseidon" 0 )
)
+Name: Jettison
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( invalidate-goal "Doomed survives" )
   ( add-remove-escort "Isis" 15 )
   ( add-remove-escort "Poseidon" 0 )
)
+Name: Invalidate
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( self-destruct "Doomed" )
   ( modify-variable @phase[0] 1 )
)
+Name: Doom
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( validate-goal "Doomed survives" )
)
+Name: Validate
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( self-destruct "Beta 4" )
)
+Name: Losses
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( change-iff "Hostile" "Beta 3" )
   ( add-goal "Beta 3" ( ai-chase "Beta 1" 89 ) )
   ( send-message "#Command" "High" "Defect" )
)
+Name: Defect
+Repeat Count: 1
+Interval: 1
+Chained: 10

$Formula: ( when
   ( true )
   ( training-msg "Training" )
)
+Name: Training
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( when
   ( true )
   ( cond ( ( = @phase[0] 1 ) ( modify-variable @phase[0] 2 ) ( send-message "#Command" "Normal" "Phase two" ) ) ( ( true ) ( send-message "#Command" "Normal" "Phase none" ) ) )
)
+Name: Branch
+Repeat Count: 1
+Interval: 1
+Chained: 5

$Formula: ( and-in-sequence ( is-event-true-delay "Cargo" 0 ) ( is-event-true-delay "Doom" 0 ) )
+Name: Sequence
+Repeat Count: 1
+Interval: 1

$Formula: ( not ( is-destroyed-delay 0 "Doomed" ) )
+Name: Doomed alive
+Repeat Count: 1
+Interval: 1
+Objective:  XSTR("Keep the Doomed alive", -1)

$Formula: ( and ( has-time-elapsed 60 ) ( > ( hits-left "Isis" ) 50 ) ( < ( distance "Alpha 1" "Isis" ) 2000 ) ( not ( < ( shields-left "Isis" ) 0 ) ) )
+Name: Late
+Repeat Count: 1
+Interval: 1

$Formula: ( percent-ships-destroyed 25 "Beta 1" "Beta 2" "Beta 3" "Beta 4" )
+Name: Fighters lost
+Repeat Count: 1
+Interval: 1

$Formula: ( ship-type-destroyed 1 "freighter" )
+Name: Freighter killed
+Repeat Count: 1
+Interval: 1

$Formula: ( is-cargo-known-delay 0 "Isis" )
+Name: Cargo known
+Repeat Count: 1
+Interval: 1

