   ( add-goal "Beta 1" ( ai-warp-out 89 ) )
   ( add-goal "Beta 2" ( ai-warp-out 89 ) )
   ( add-goal "Deimos" ( ai-warp-out 89 ) )
   ( change-iff "Hostile" "Freighter" )
