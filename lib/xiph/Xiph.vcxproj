    <ClCompile Include="vorbis\lib\lookup.c" />
    <ClCompile Include="vorbis\lib\lpc.c" />
    <ClCompile Include="vorbis\lib\lsp.c" />
    <ClCompile Include="vorbis\lib\mapping0.c" />
