    <ClCompile Include="vorbis\lib\smallft.c" />
    <ClCompile Include="vorbis\lib\synthesis.c" />
    <ClCompile Include="vorbis\lib\window.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
